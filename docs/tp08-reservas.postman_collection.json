{
  "info": {
    "name": "TP 08 - Reservas de salas (API)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solicitudes de la matriz del TP 08. Variable base = http://localhost:3000. El POST válido guarda el id recibido en la variable id. No contiene secretos."
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:3000"
    },
    {
      "key": "id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Listado y creación",
      "item": [
        {
          "name": "GET listado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/reservas",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            }
          }
        },
        {
          "name": "POST reserva válida (201 + Location)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/reservas",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estudiante\": \"Ana Ejemplo\",\n  \"email\": \"ana@example.com\",\n  \"sala\": \"Sala Norte\",\n  \"fecha\": \"2026-10-21\",\n  \"turno\": \"Mañana\",\n  \"personas\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('tiene Location', () => pm.response.to.have.header('Location'));",
                  "pm.collectionVariables.set('id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET reserva creada (usa {{id}})",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/reservas/{{id}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "reservas",
                "{{id}}"
              ]
            }
          }
        }
      ]
    },
