                  "key": "sala",
                  "value": "Sala Norte"
                }
              ]
            }
          }
        },
        {
          "name": "GET sala sin coincidencias ([])",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/reservas?sala=Sala Sur",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "reservas"
              ],
              "query": [
                {
                  "key": "sala",
                  "value": "Sala Sur"
                }
              ]
            }
          }
        },
        {
          "name": "GET sala repetida (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/reservas?sala=Sala Norte&sala=Sala Sur",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "reservas"
              ],
              "query": [
                {
                  "key": "sala",
                  "value": "Sala Norte"
                },
                {
                  "key": "sala",
                  "value": "Sala Sur"
                }
              ]
            }
          }
        }
      ]
    },
