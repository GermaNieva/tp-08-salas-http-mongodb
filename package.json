    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "mongoose": "9.10.3",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10"
  }
}
