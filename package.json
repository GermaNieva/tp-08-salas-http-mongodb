{
  "name": "tp-08-salas-http-mongodb",
  "version": "1.0.0",
  "description": "Reservas de salas de estudio con sitio HTML y API JSON persistentes en MongoDB Atlas (Express, Mongoose, EJS).",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "start:local": "node --env-file=.env src/index.js",
